@page "/hotel/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components 
@using System.Security.Claims 
@using Rezervasyon.Client.Models 
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider 

@if (hotel == null)
{
    <p><em>Otel bilgileri yükleniyor...</em></p>
}
else
{
    <PageTitle>@hotel.Name</PageTitle>

    <div class="row">
        <div class="col-md-7">
            <h1>@hotel.Name</h1>
            <p class="text-muted">@hotel.City</p>
            <p><strong>Yıldız Sayısı:</strong> @hotel.Stars ⭐</p>
            <hr />
            <p>Otel açıklaması...</p>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4>Rezervasyon Yap</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="reservationDetails" OnValidSubmit="HandleReservation">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Kişi Ad Soyad</label>
                                <InputTextArea class="form-control" @bind-Value="reservationDetails.KisiAdSoyad" rows="1" @bind-Value:after="CalculatePriceAsync" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Giriş Tarihi</label>
                                <InputDate class="form-control" @bind-Value="reservationDetails.GirisTarihi" @bind-Value:after="CalculatePriceAsync" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Çıkış Tarihi</label>
                                <InputDate class="form-control" @bind-Value="reservationDetails.CikisTarihi" @bind-Value:after="CalculatePriceAsync" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Yetişkin</label>
                                <InputNumber class="form-control" @bind-Value="reservationDetails.YetiskinSayisi" @bind-Value:after="CalculatePriceAsync" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Çocuk</label>
                                <InputNumber class="form-control" @bind-Value="reservationDetails.CocukSayisi" @bind-Value:after="CalculatePriceAsync" />
                            </div>

                            <div class="col-12 mt-3">
                                <label class="form-label">Hesaplanan Fiyat:</label>
                                @if (isCalculatingPrice)
                                {
                                    <p><em>Fiyat hesaplanıyor...</em></p>
                                }
                                else if (!string.IsNullOrEmpty(priceCalculationError))
                                {
                                    <div class="alert alert-danger py-1">@priceCalculationError</div>
                                }
                                else if (calculatedPriceInfo != null)
                                {
                                    <p class="fw-bold fs-5">
                                        @calculatedPriceInfo.ToplamTutar.ToString("N2") @calculatedPriceInfo.ParaBirimiKodu
                                        <small class="text-muted fw-normal">(@calculatedPriceInfo.GeceSayisi gece)</small>
                                    </p>
                                }
                                else
                                {
                                    <p><em>Fiyatı hesaplamak için tarihleri ve kişi sayısını girin.</em></p>
                                }
                            </div>
                            <div class="col-12">
                                <label class="form-label">Açıklama (İsteğe Bağlı)</label>
                                <InputTextArea class="form-control" @bind-Value="reservationDetails.Aciklama" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 mt-3" disabled="@(isCalculatingPrice || calculatedPriceInfo == null)">
                            Rezervasyonu Tamamla
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; } 

    
    [SupplyParameterFromQuery] public DateTime? checkIn { get; set; }
    [SupplyParameterFromQuery] public DateTime? checkOut { get; set; }
    [SupplyParameterFromQuery] public int adults { get; set; } = 1; 
    [SupplyParameterFromQuery] public int children { get; set; } = 0;

    private Hotel? hotel;
    private Reservation reservationDetails = new(); 
    private PriceCalculationResult? calculatedPriceInfo;
    private bool isCalculatingPrice = false;
    private string? priceCalculationError;
    private string? currentUserId; 

  
   

    protected override async Task OnInitializedAsync()
    {
        
        hotel = await Http.GetFromJsonAsync<Hotel>($"api/hotels/{Id}");

        
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;


       
        reservationDetails.GirisTarihi = checkIn ?? DateTime.Today;
        reservationDetails.CikisTarihi = checkOut ?? DateTime.Today.AddDays(1);
        reservationDetails.YetiskinSayisi = adults > 0 ? adults : 1; 
        reservationDetails.CocukSayisi = children >= 0 ? children : 0;

       
        await CalculatePriceAsync();
    }

    private async Task CalculatePriceAsync()
    {
        

        if (Id <= 0 || reservationDetails.GirisTarihi == default || reservationDetails.CikisTarihi == default || reservationDetails.GirisTarihi >= reservationDetails.CikisTarihi || reservationDetails.YetiskinSayisi <= 0)
        {
            calculatedPriceInfo = null;
            priceCalculationError = "Lütfen geçerli tarih aralığı ve en az 1 yetişkin seçin.";
            StateHasChanged();
            return;
        }

        isCalculatingPrice = true;
        priceCalculationError = null;
        calculatedPriceInfo = null;
        StateHasChanged();

        try
        { 
            string requestUri = $"api/prices/calculate?hotelId={Id}&giris={reservationDetails.GirisTarihi:yyyy-MM-dd}&cikis={reservationDetails.CikisTarihi:yyyy-MM-dd}&yetiskinsayisi={reservationDetails.YetiskinSayisi}&cocuksayisi={reservationDetails.CocukSayisi}";
            var response = await Http.GetAsync(requestUri);

            if (response.IsSuccessStatusCode)
            {
                calculatedPriceInfo = await response.Content.ReadFromJsonAsync<PriceCalculationResult>();
            }
            else
            {
                priceCalculationError = $"Fiyat hesaplanamadı: ({response.StatusCode}) {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { priceCalculationError = $"Hesaplama hatası: {ex.Message}"; }
        finally { isCalculatingPrice = false; StateHasChanged(); }
    }

    private async Task HandleReservation()
    {
        if (calculatedPriceInfo == null || priceCalculationError != null || string.IsNullOrEmpty(currentUserId))
        {
            
            Console.WriteLine("Fiyat hesaplanamadı veya kullanıcı ID'si alınamadı.");
            return;
        }

       
        var newReservation = new Reservation
        {
			KisiAdSoyad = reservationDetails.KisiAdSoyad,
            GirisTarihi = reservationDetails.GirisTarihi,
            CikisTarihi = reservationDetails.CikisTarihi,
            YetiskinSayisi = reservationDetails.YetiskinSayisi,
            CocukSayisi = reservationDetails.CocukSayisi,
            ToplamFiyat = calculatedPriceInfo.ToplamTutar,
            Aciklama = reservationDetails.Aciklama ?? string.Empty,
            UserId = int.Parse(currentUserId), 
            HotelId = Id 
        };

     
        var response = await Http.PostAsJsonAsync("api/reservations", newReservation);

        if (response.IsSuccessStatusCode)
        {
          
            Console.WriteLine("Rezervasyon başarıyla oluşturuldu!");
            NavigationManager.NavigateTo("/"); 
        }
        else
        {
           
            var errorMessage = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Rezervasyon oluşturulamadı: ({response.StatusCode}) {errorMessage}");
          
        }
    }
}